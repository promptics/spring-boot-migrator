From 9b942d796bafe304bb401f6fe3da75f744234f16 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 4 May 2026 09:40:59 +0000
Subject: [PATCH] fix(parser): mark resource inputs synthetic so
 PropertiesParser accepts spring.factories

The prior commit (a7e72f7) routes spring.factories paths into propertiesPaths,
but PropertiesParser.parseInputs internally re-filters via acceptedInputs which
calls accept(Input) -> accept(Path), and Path-based accept literally checks
endsWith('.properties'). Result: spring.factories survives routing but is
dropped silently inside parseInputs, returning an empty result.

Switch getInputs to the 4-arg Parser.Input constructor with synthetic=true.
The synthetic flag means 'content is provided via the supplier; do not
re-derive from path' - Parser.accept(Input) returns true unconditionally for
synthetic inputs, bypassing the Path-extension re-check. This matches the
existing pattern in MavenModuleParser.parseSourceSet:250 where Java sources
also use synthetic=Files.exists(path).
---
 .../rewrite/parser/RewriteResourceParser.java            | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/spring-rewrite-commons-launcher/src/main/java/org/springframework/rewrite/parser/RewriteResourceParser.java b/spring-rewrite-commons-launcher/src/main/java/org/springframework/rewrite/parser/RewriteResourceParser.java
index 2981f59..27f500b 100644
--- a/spring-rewrite-commons-launcher/src/main/java/org/springframework/rewrite/parser/RewriteResourceParser.java
+++ b/spring-rewrite-commons-launcher/src/main/java/org/springframework/rewrite/parser/RewriteResourceParser.java
@@ -17,6 +17,7 @@ package org.springframework.rewrite.parser;
 
 import org.jetbrains.annotations.NotNull;
 import org.openrewrite.ExecutionContext;
+import org.openrewrite.FileAttributes;
 import org.openrewrite.Parser;
 import org.openrewrite.SourceFile;
 import org.openrewrite.hcl.HclParser;
@@ -290,8 +291,14 @@ public class RewriteResourceParser {
 
 	@NotNull
 	private static List<Parser.Input> getInputs(Map<Path, Resource> pathResourceMap, List<Path> paths) {
+		// Mark inputs synthetic=true: content is provided via the InputStream supplier,
+		// not re-read from disk by the parser. This also bypasses the parser's default
+		// path-extension re-check inside parseInputs (Parser.accept(Input) returns true
+		// when synthetic), which is needed for files routed by name rather than extension
+		// — e.g. spring.factories routed to PropertiesParser despite lacking .properties.
 		return paths.stream()
-			.map(path -> new Parser.Input(path, () -> ResourceUtil.getInputStream(pathResourceMap.get(path))))
+			.map(path -> new Parser.Input(path, FileAttributes.fromPath(path),
+					() -> ResourceUtil.getInputStream(pathResourceMap.get(path)), true))
 			.toList();
 	}
 
