From 9bcd504191deaca265acfc250e4148697183b6d9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 3 May 2026 22:25:05 +0000
Subject: [PATCH] fix(parser): route spring.factories through PropertiesParser
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

spring.factories files use Java properties syntax but the .factories
extension means PropertiesParser.accept() rejects them. They fall
through to QuarkParser, whose printAll() returns empty content — so
recipes that read EnableAutoConfiguration entries (e.g. SBM's
CreateAutoconfigurationActionTest, BootHasAutoconfigurationConditionTest,
SpringFactoriesHelperTest) see an empty file and produce wrong output.

Route any path ending in spring.factories through PropertiesParser
explicitly so it's parsed as Properties.File and downstream recipes
can read its content.
---
 .../rewrite/parser/RewriteResourceParser.java               | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/spring-rewrite-commons-launcher/src/main/java/org/springframework/rewrite/parser/RewriteResourceParser.java b/spring-rewrite-commons-launcher/src/main/java/org/springframework/rewrite/parser/RewriteResourceParser.java
index ec93a95..2981f59 100644
--- a/spring-rewrite-commons-launcher/src/main/java/org/springframework/rewrite/parser/RewriteResourceParser.java
+++ b/spring-rewrite-commons-launcher/src/main/java/org/springframework/rewrite/parser/RewriteResourceParser.java
@@ -200,7 +200,11 @@ public class RewriteResourceParser {
 			else if (yamlParser.accept(path)) {
 				yamlPaths.add(path);
 			}
-			else if (propertiesParser.accept(path)) {
+			else if (propertiesParser.accept(path) || path.toString().endsWith("spring.factories")) {
+				// spring.factories has properties syntax but lacks the .properties extension,
+				// so propertiesParser.accept() rejects it. Route it through PropertiesParser
+				// explicitly so downstream recipes can read its content via Properties.File
+				// (otherwise it's parsed as Quark and prints empty).
 				propertiesPaths.add(path);
 			}
 			else if (protoParser.accept(path)) {
-- 
